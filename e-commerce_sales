-- Q46. Find average spending per customer
SELECT
    AVG(customer_spending) AS average_spending
FROM (
    SELECT
        o.customer_id,
        SUM(p.price * o.quantity) AS customer_spending
    FROM orders o
    JOIN products p ON o.product_id = p.product_id
    GROUP BY o.customer_id
) AS customer_sales;
