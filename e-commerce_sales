-- Q35. Calculate revenue for each order
SELECT
    o.order_id,
    p.product_name,
    p.price * o.quantity AS order_revenue
FROM orders o
JOIN products p ON o.product_id = p.product_id;

-- Q36. Find customers spending more than 10000
SELECT
    c.customer_name,
    SUM(p.price * o.quantity) AS total_spending
FROM customers c
JOIN orders o ON c.customer_id = o.customer_id
JOIN products p ON o.product_id = p.product_id
GROUP BY c.customer_id, c.customer_name
HAVING SUM(p.price * o.quantity) > 10000;

-- Q37. Find the latest order date
SELECT MAX(order_date) AS latest_order_date
FROM orders;

-- Q38. Count orders month-wise
SELECT
    MONTHNAME(order_date) AS month_name,
    COUNT(*) AS total_orders
FROM orders
GROUP BY MONTH(order_date), MONTHNAME(order_date)
ORDER BY MONTH(order_date);

-- Q39. Categorize products based on price
SELECT
    product_name,
    price,
    CASE
        WHEN price >= 20000 THEN 'High'
        WHEN price >= 5000 THEN 'Medium'
        ELSE 'Low'
    END AS price_category
FROM products;

-- Q40. Calculate total company revenue
SELECT
    SUM(p.price * o.quantity) AS total_revenue
FROM orders o
JOIN products p ON o.product_id = p.product_id;

-- Q41. Find the highest-selling product
SELECT
    p.product_name,
    SUM(o.quantity) AS total_quantity
FROM products p
JOIN orders o ON p.product_id = o.product_id
GROUP BY p.product_id, p.product_name
ORDER BY total_quantity DESC
LIMIT 1;

-- Q42. Find customers without orders
SELECT
    c.customer_name
FROM customers c
LEFT JOIN orders o ON c.customer_id = o.customer_id
WHERE o.order_id IS NULL;

-- Q43. Find total revenue by city
SELECT
    c.city,
    SUM(p.price * o.quantity) AS total_revenue
FROM customers c
JOIN orders o ON c.customer_id = o.customer_id
JOIN products p ON o.product_id = p.product_id
GROUP BY c.city;

